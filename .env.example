# Salin ke .env lalu isi. JANGAN commit file .env.

# --- LLM pemilih highlight: anthropic | openai | ollama | claude (Claude Code CLI, hanya native) ---
AUTOCLIPPER_LLM=anthropic
# Model (opsional). Default: claude-haiku-5-5 / gpt-4o-mini / qwen2.5:7b
# AUTOCLIPPER_LLM_MODEL=

ANTHROPIC_API_KEY=

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # ganti untuk server kompatibel OpenAI

# Ollama: jalankan dengan `docker compose --profile ollama up`, lalu
# AUTOCLIPPER_LLM=ollama
# OLLAMA_HOST=http://ollama:11434
# AUTOCLIPPER_LLM_MODEL=qwen2.5:7b

# --- Transkripsi ---
# tiny | base | small | medium | large-v3 (CPU: small/medium disarankan)
AUTOCLIPPER_WHISPER_MODEL=small
# auto | cpu | cuda
AUTOCLIPPER_DEVICE=auto

# --- Download YouTube ---
# Kalau kena "Sign in to confirm you're not a bot": ekspor cookies.txt, taruh di ./cookies.txt
# dan hilangkan komentar baris di bawah (path di dalam container).
# AUTOCLIPPER_COOKIES=/run/cookies.txt
